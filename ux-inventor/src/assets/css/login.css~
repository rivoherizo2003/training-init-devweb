.container {
  width: 100%;
  /*centrer horizontalement un élément de type bloc (comme une div) à l'intérieur de son parent.*/
  margin-left: auto;
  margin-right: auto;
}

/** Login page **/
.login-wrapper {
  min-height: 100vh;
  display: flex;
  align-items: center;
}

.login-section {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.form-login {
  width: 70%;
}

.logo-left {
  min-height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;

  .img-logo {
    width: 40%;
    display: block;
  }
}

.logo-left-title {
  color: #2b9a9d;
  font-weight: bold;
  font-family: inter;
}
/*******************/

.debug {
  border: 1px solid red;
}

/** GRID **/
.grid {
  .row {
    width: 100%;
    display: flex;
  }
}

.col-sm {
  width: 50%;
}
